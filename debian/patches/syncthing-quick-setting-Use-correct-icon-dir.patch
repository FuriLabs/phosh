From: =?utf-8?q?Guido_G=C3=BCnther?= <agx@sigxcpu.org>
Date: Sat, 27 Jun 2026 22:52:10 +0200
Subject: syncthing-quick-setting: Use correct icon dir
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

We put those into the plugins dir

Signed-off-by: Guido Günther <agx@sigxcpu.org>
---
 plugins/syncthing-quick-setting/icons/meson.build                     | 4 ++--
 plugins/syncthing-quick-setting/syncthing-quick-setting.desktop.in.in | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/plugins/syncthing-quick-setting/icons/meson.build b/plugins/syncthing-quick-setting/icons/meson.build
index e883909..bb3e05b 100644
--- a/plugins/syncthing-quick-setting/icons/meson.build
+++ b/plugins/syncthing-quick-setting/icons/meson.build
@@ -1,5 +1,5 @@
 install_data(
   'cloud-filled-symbolic.svg',
-  rename: 'mobi.phosh.Shell.Plugins.Syncthing-symbolic.svg',
-  install_dir: datadir / 'icons' / 'hicolor' / 'symbolic' / 'apps',
+  rename: 'syncthing-quick-setting-symbolic.svg',
+  install_dir: phosh_plugin_icon_dir,
 )
diff --git a/plugins/syncthing-quick-setting/syncthing-quick-setting.desktop.in.in b/plugins/syncthing-quick-setting/syncthing-quick-setting.desktop.in.in
index a66a24f..7d664f2 100644
--- a/plugins/syncthing-quick-setting/syncthing-quick-setting.desktop.in.in
+++ b/plugins/syncthing-quick-setting/syncthing-quick-setting.desktop.in.in
@@ -5,4 +5,4 @@ Name=Syncthing Quick Setting
 Types=quick-setting;
 Comment=A quick setting for Syncthing.
 Plugin=@plugins_dir@/libphosh-plugin-@name@.so
-Icon=mobi.phosh.Shell.Plugins.Syncthing
+Icon=syncthing-quick-setting
