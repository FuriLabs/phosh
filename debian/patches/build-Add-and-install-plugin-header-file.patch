From: =?utf-8?q?Guido_G=C3=BCnther?= <agx@sigxcpu.org>
Date: Sat, 17 Dec 2022 17:11:39 +0100
Subject: build: Add and install plugin header file
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

This simplifies external plugins.

Signed-off-by: Guido Günther <guido.gunther@puri.sm>
Part-of: <https://gitlab.gnome.org/World/Phosh/phosh/-/merge_requests/1168>
---
 plugins/meson.build       | 15 ++++++++++++++-
 plugins/phosh-plugin.h.in | 11 +++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)
 create mode 100644 plugins/phosh-plugin.h.in

diff --git a/plugins/meson.build b/plugins/meson.build
index 8ca27ce..b0a7028 100644
--- a/plugins/meson.build
+++ b/plugins/meson.build
@@ -1,5 +1,18 @@
+phosh_plugin_header_subdir = 'phosh'
+
+phosh_plugin_config = configuration_data()
+phosh_plugin_config.set_quoted('PHOSH_PLUGIN_EXTENSION_POINT_LOCKSCREEN_WIDGET', 'phosh-lockscreen-widget')
+phosh_plugin_h = configure_file(
+  input: 'phosh-plugin.h.in',
+  output: 'phosh-plugin.h',
+  configuration: phosh_plugin_config,
+)
+install_headers([phosh_plugin_h], subdir: phosh_plugin_header_subdir)
+
 if get_option('lockscreen-plugins')
 
+plugin_inc = include_directories('.')
+
 subdir('calendar')
 subdir('upcoming-events')
 subdir('ticket-box')
@@ -9,7 +22,7 @@ endif
 pkgconfig.generate(
   variables : ['lockscreen_plugins_dir=@0@'.format(plugins_dir),
               ],
-  subdirs : 'phosh',
+  subdirs : phosh_plugin_header_subdir,
   version : meson.project_version(),
   install_dir : libdir / 'pkgconfig',
   filebase : 'phosh-plugins',
diff --git a/plugins/phosh-plugin.h.in b/plugins/phosh-plugin.h.in
new file mode 100644
index 0000000..a09abdb
--- /dev/null
+++ b/plugins/phosh-plugin.h.in
@@ -0,0 +1,11 @@
+/*
+ * Copyright (C) 2022 Guido Günther
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Author: Guido Günther <agx@sigxcpu.org>
+ */
+
+#pragma once
+
+#mesondefine PHOSH_PLUGIN_EXTENSION_POINT_LOCKSCREEN_WIDGET
