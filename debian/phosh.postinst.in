#!/bin/sh

set -e

if [ "$1" = triggered ]; then
    set +m; "/usr/lib/#MULTIARCH#/glib-2.0/gio-querymodules" "/usr/lib/#MULTIARCH#/phosh/plugins" &> /dev/null; set -m
    set +m; "/usr/lib/#MULTIARCH#/glib-2.0/gio-querymodules" "/usr/lib/#MULTIARCH#/phosh/plugins/prefs" &> /dev/null; set -m
    exit 0
fi

#DEBHELPER#

set +m; "/usr/lib/#MULTIARCH#/glib-2.0/gio-querymodules" "/usr/lib/#MULTIARCH#/phosh/plugins" &> /dev/null; set -m
set +m; "/usr/lib/#MULTIARCH#/glib-2.0/gio-querymodules" "/usr/lib/#MULTIARCH#/phosh/plugins/prefs" &> /dev/null; set -m
